SITE_ADDRESS=:80
DEEPSEEK_API_KEY=
ADMIN_TOKEN=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
AI_TIMEOUT_MS=90000
# 旧 Android file:// 安装包才需要 null；新网站同源访问不需要填写。
